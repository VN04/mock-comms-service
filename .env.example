# Copy to `.env`. Docker Compose has working defaults for everything, so this
# file is optional there — it's mainly for overrides (e.g. real AWS S3).
#
# Running the app on the host (`pnpm start:dev` / `pnpm start:worker:dev`)
# against the dockerised MySQL/Redis/MinIO? Use the "host" values noted below.

# --- App ---
NODE_ENV=development
PORT=3000
# Base URL clients use to reach the API (used to build ws_url). Optional.
PUBLIC_BASE_URL=http://localhost:3000

# --- MySQL / Redis: only read when running the app on the host (compose wires these itself) ---
DB_HOST=localhost
DB_PORT=3307
DB_USER=comms
DB_PASSWORD=comms
DB_NAME=comms
DB_POOL_SIZE=10

# --- Redis ---
REDIS_URL=redis://localhost:6380

# --- Object storage: MinIO (default) ---
S3_BUCKET=recordings
S3_REGION=us-east-1
# Endpoint the app uploads to: http://minio:9000 inside Docker, http://localhost:9000 on the host.
S3_ENDPOINT=http://minio:9000
# Endpoint embedded in signed URLs handed to clients.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# --- Object storage: real AWS S3 (uncomment, fill in, and blank the endpoints) ---
# Use a dedicated IAM user limited to s3:PutObject + s3:GetObject on this bucket.
# S3_BUCKET=your-bucket-name
# S3_REGION=ap-south-1
# S3_ENDPOINT=
# S3_PUBLIC_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=AKIA...
# S3_SECRET_ACCESS_KEY=...

RECORDING_URL_TTL_SECONDS=3600
RECORDING_UPLOAD_ATTEMPTS=5

# --- Call provider (mock simulator) ---
CALL_PROVIDER=mock
MOCK_STEP_DELAY_MIN_MS=1000
MOCK_STEP_DELAY_MAX_MS=3000
MOCK_TALK_DURATION_MIN_MS=3000
MOCK_TALK_DURATION_MAX_MS=8000
MOCK_ANSWER_PROBABILITY=0.5

# --- Rate limits (defaults; per-key overrides live in the api_keys table) ---
RATE_LIMIT_DEFAULT_MAX_CONCURRENT=3
RATE_LIMIT_DEFAULT_MAX_CPS=2
# Leaked concurrency slots (e.g. a crashed job) are reclaimed after this long.
RATE_LIMIT_STALE_SLOT_MS=600000

# --- Caching / TTLs ---
API_KEY_CACHE_TTL_SECONDS=60
IDEMPOTENCY_TTL_SECONDS=86400
# How long a finished call stays hot in Redis before reads fall back to MySQL.
CALL_STATE_TTL_SECONDS=3600
# WebSocket tokens: valid long past any call; cut to the grace period on completion.
WS_TOKEN_TTL_SECONDS=3600
WS_TOKEN_GRACE_SECONDS=300

# --- Persistence (Redis -> MySQL) ---
PERSISTENCE_FLUSH_INTERVAL_MS=5000
PERSISTENCE_BATCH_SIZE=500
EVENT_STREAM_MAX_LENGTH=1000000

# --- Seed API keys (created by the migrate step if missing; min 16 chars) ---
# Leave empty to generate random keys (printed once in the migrate logs).
SEED_ADMIN_API_KEY=dev_admin_key_change_me
SEED_CLIENT_API_KEY=dev_client_key_change_me
